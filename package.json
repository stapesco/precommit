{
  "name": "stapes-precommit",
  "version": "0.2.0",
  "description": "Zero-config pre-commit hook with five sanity checks: secrets, large files, console.log, TODO markers, sensitive paths. One command to install, zero config to maintain. Zero telemetry. Stable --json output for AI agents and CI.",
  "license": "MIT",
  "author": "stapesco <github@stapes.co.za>",
  "homepage": "https://github.com/stapesco/precommit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stapesco/precommit.git"
  },
  "bugs": {
    "url": "https://github.com/stapesco/precommit"
  },
  "keywords": [
    "pre-commit",
    "git",
    "git-hooks",
    "secrets",
    "lint",
    "static-analysis",
    "aws-keys",
    "console-log",
    "ai-agent",
    "cli",
    "npx",
    "zero-config",
    "stapes"
  ],
  "bin": {
    "stapes-precommit": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "commander": "^15.1.0"
  }
}
